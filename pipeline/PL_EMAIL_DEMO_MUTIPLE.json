{
	"name": "PL_EMAIL_DEMO_MUTIPLE",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-18.centralindia.logic.azure.com:443/workflows/9589a74c6ca54e88a3621fa6c5ccac21/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=TZUPpZjb1YOoTv7l-PMMguGETIB49Hye5_QypQDxyO0",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"email_recepient\" : \"@{pipeline().parameters.email_recepient}\",\n\"subject\" : \"@{variables('email_subject')}\",\n\"body\" : \"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The ingestion process has been completed for all  tables and below is the status :\n\n@{replace(string(pipeline().parameters.table_status),'\"','')}\n\n\nPipeline run id : @{pipeline().RunId}\n\n",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "string"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-30T09:58:45Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}